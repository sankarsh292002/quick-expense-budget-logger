# Copy this file to ".env" and put in YOUR PostgreSQL password.
# .env is listed in .gitignore, so your password never goes to GitHub.
#
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://postgres:postgres123@localhost:5432/expense_logger

# Used to sign login tokens. Any long random text; change it for anything real.
SECRET_KEY=change-me-to-a-long-random-text
