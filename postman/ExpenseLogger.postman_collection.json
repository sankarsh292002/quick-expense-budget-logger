            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"postman_user\",\n  \"email\": \"postman_user@example.com\",\n  \"password\": \"postman123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201 or 409\", () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in (saves the token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"postman_user\",\n  \"password\": \"postman123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "pm.collectionVariables.set(\"token\", pm.response.json().access_token);",
                  "pm.test(\"Token received\", () => pm.expect(pm.response.json().access_token).to.be.a(\"string\"));",
                  "pm.test(\"Token is a JWT with sub and exp\", () => {",
                  "    const parts = pm.response.json().access_token.split(\".\");",
                  "    pm.expect(parts.length).to.eql(3);  // header.payload.signature",
                  "    const payload = JSON.parse(atob(parts[1].replace(/-/g, \"+\").replace(/_/g, \"/\")));",
                  "    pm.expect(payload).to.have.property(\"sub\");",
                  "    pm.expect(payload).to.have.property(\"exp\");",
                  "});"
                ]
              }
            }
          ]
        },
